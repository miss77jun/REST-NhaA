set A = 115.800
set B = 100.560
set C = 141.612
set alpha = 90.00
set beta = 97.00
set gamma = 90.00
calc ncopy = 1 + 1

! You can increase 'CUTOFF' to have more crystal images

COOR CONVERT ALIGNED SYMMETRIC @A @B @C @alpha @beta @gamma
CRYSTAL DEFINE MONOclinic @A @B @C @alpha @beta @gamma
CRYSTAL BUILD NOPER 1 CUTOFF 20.0
(-X,1/2+Y,-Z)

! Please note that this option is only for the purpose of
! generating crystal images.
! You can increase 'cutim' to get more atoms in crystal images 
! imall : to print all the images

nbonds atom switch cdie vdw vfswitch imall - !bycb 
       ctonnb 10.0 ctofnb 12.0 cutnb 24.0 cutim 24.0

open write card unit 10 name step1_crystal.pdb
write coor pdb  unit 10 images

open  write unit 90 card name step1_unitcell.info
write title unit 90
